debug-script 1
limit-frame 5000
wait-frame 1200
input-line ZUNDORB
wait-pc 3000:3000 1
capture m98o-probe registers
wait-pc 3000:3010 1
capture m98o-load registers
wait-pc 3000:3020 1
capture m98o-initialize registers
wait-pc 3000:3030 1
capture m98o-flip-1 registers gvram screen
wait-pc 3000:3030 1
capture m98o-flip-2 registers gvram screen
wait-pc 3000:3030 1
capture m98o-flip-3 registers gvram screen
wait-pc 3000:3030 1
capture m98o-flip-4 registers gvram screen
wait-pc 3000:3040 1
capture m98o-settled-a registers gvram screen
wait-pc 3000:3040 1
capture m98o-settled-b registers gvram screen
enter
wait-pc 3000:3050 1
capture m98o-report-a registers
wait-pc 3000:3060 1
capture m98o-report-b registers
wait-pc 3000:3070 1
capture m98o-report-c registers
exit
