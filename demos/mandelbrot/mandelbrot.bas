20 ' N88 BASIC V3.1 640X400 HSV MANDELBROT
100 SCREEN WIDTH 1,640,4
110 PALETTE MODE 2,0,0,0
120 PALETTE
130 SV=1:VV=1
140 PALETTE 0,0
150 FOR PP=1 TO 15
160 HU=(PP-1)*360/15
170 GOSUB 3000
180 PALETTE PP,CO
190 NEXT PP
200 XA=-2.25:XB=0.75
210 YA=-1.25:YB=1.25
220 DX=(XB-XA)/639
230 DY=(YB-YA)/399
240 MI=32
250 CLS 3
260 CI=YA
270 FOR Y=0 TO 399
280 CR=XA
290 FOR X=0 TO 639
300 ZR=0:ZI=0:R2=0:I2=0:IT=0
310 IF IT>=MI THEN 390
320 NR=R2-I2+CR
330 NI=2*ZR*ZI+CI
340 ZR=NR:ZI=NI
350 R2=ZR*ZR:I2=ZI*ZI
360 IT=IT+1
370 IF R2+I2>4 THEN 400
380 GOTO 310
390 PP=0
400 IF R2+I2>4 THEN PP=1+INT(IT*14/MI)
410 PSET (X,Y),PP
420 CR=CR+DX
430 NEXT X
440 CI=CI+DY
450 NEXT Y
460 END
3000 HV=HU/60
3010 SE=INT(HV)
3020 FR=HV-SE
3030 PV=VV*(1-SV)
3040 QV=VV*(1-SV*FR)
3050 TV=VV*(1-SV*(1-FR))
3060 IF SE=0 THEN 3130
3070 IF SE=1 THEN 3170
3080 IF SE=2 THEN 3210
3090 IF SE=3 THEN 3250
3100 IF SE=4 THEN 3290
3110 RV=VV:GV=PV:BV=QV:GOTO 3330
3130 RV=VV:GV=TV:BV=PV:GOTO 3330
3170 RV=QV:GV=VV:BV=PV:GOTO 3330
3210 RV=PV:GV=VV:BV=TV:GOTO 3330
3250 RV=PV:GV=QV:BV=VV:GOTO 3330
3290 RV=TV:GV=PV:BV=VV
3330 RI=INT(RV*15+0.5)
3340 GI=INT(GV*15+0.5)
3350 BI=INT(BV*15+0.5)
3360 AD=0:IF GI>0 THEN AD=3072
3370 GC=GI*4096+AD
3380 AD=0:IF RI>0 THEN AD=32
3390 RC=RI*64+AD
3400 AD=0:IF BI>0 THEN AD=1
3410 BC=BI*2+AD
3420 CO=GC+RC+BC
3430 RETURN
