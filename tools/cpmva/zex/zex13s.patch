 ; <inc,dec> a (3072 cycles)
 inca:	db	0d7h		; flag mask
 	tstr	03ch,0,0,0,04adfh,0d5d8h,0e598h,08a2bh,0a7b0h,0431bh,044h,05ah,0d030h
