M101 ZEX13S: the file-output ZEXDOC with the <daa,cpl,scf,ccf> group split
into single-opcode groups (ZEX13S.COM writes ZEX13S.TXT).

This patch modifies ZEX and is distributed under the GPL-2.0-or-later terms
stated in external/zex/zexdoc.src. tools/cpmva/zex/zexbuild.py applies it
after zexdoc-fileout.patch. msbt and the original descriptors are unchanged.
The expected CRCs of the eight new groups are those of the Zilog profile.

--- a/external/zex/zexdoc.src
+++ b/external/zex/zexdoc.src
@@ -94,7 +94,7 @@
 	ld	c,9
 	call	bdos
 
-	ld	hl,tests	; first test case
+	ld	hl,tests13	; vaeg ZEX13S: first test case
 loop:	ld	a,(hl)		; end of list ?
 	inc	hl
 	or	(hl)
@@ -109,6 +109,22 @@
 	call	fclose		; vaeg: flush and close the log file
 	jp	0		; warm boot
 
+; vaeg M101 ZEX13S test table: two build controls, then DAA, CPL, SCF and CCF
+; each alone, with flag mask D7h and FFh. This addition is distributed under
+; the same GPL-2.0-or-later terms as the rest of this file.
+tests13:
+	dw	alu8i
+	dw	daaop
+	dw	x27d7
+	dw	x27ff
+	dw	x2fd7
+	dw	x2fff
+	dw	x37d7
+	dw	x37ff
+	dw	x3fd7
+	dw	x3fff
+	dw	0
+
 tests:
 	dw	adc16
 	dw	add16
@@ -311,6 +327,65 @@
 	db	09bh,04bh,0a6h,075h			; expected crc
 	tmsg	'<daa,cpl,scf,ccf>.............'
 
