FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

ARG OW_URL=https://github.com/open-watcom/open-watcom-v2/releases/download/2026-08-01-Build/open-watcom-2_0-c-linux-x64
ARG OW_SHA256=e1bc4e88fa47191118f29e53731e7f4542803c7f4c503e15d72f1f571ac0832f

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/openwatcom \
    && curl -fsSL "${OW_URL}" -o /tmp/openwatcom.zip \
    && printf '%s  %s\n' "${OW_SHA256}" /tmp/openwatcom.zip | sha256sum -c - \
    && unzip -q /tmp/openwatcom.zip -d /opt/openwatcom \
    && rm -f /tmp/openwatcom.zip \
    && chmod +x /opt/openwatcom/binl64/wasm /opt/openwatcom/binl64/wlink /opt/openwatcom/binl64/wmake \
    && test -x /opt/openwatcom/binl64/wasm \
    && test -x /opt/openwatcom/binl64/wlink \
    && test -x /opt/openwatcom/binl64/wmake

ENV WATCOM=/opt/openwatcom
ENV PATH=/opt/openwatcom/binl64:/opt/openwatcom/binl:${PATH}
ENV INCLUDE=/opt/openwatcom/h
ENV LIB=/opt/openwatcom/lib286:/opt/openwatcom/lib386

WORKDIR /src
CMD ["/bin/sh"]
